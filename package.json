{
  "name": "kwegereza-live-class",
  "version": "0.1.0",
  "description": "Kwegereza Islam Umuryango - standalone live-class (mediasoup SFU) service, deployed separately from the main API because mediasoup needs a compiled native worker that shared/cPanel hosting can't build. See README.md.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mediasoup": "^3.14.8",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^6.4.16",
    "@types/web-push": "^3.6.4",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
