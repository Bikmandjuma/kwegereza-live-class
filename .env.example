# This service has NO database of its own -- everything that needs
# persistence goes through the main API's internal API instead (see
# src/utils/internalApi.ts). MAIN_API_INTERNAL_URL is that main API's
# own base URL (reachable from this service over the network), and
# INTERNAL_API_SECRET MUST match the exact same value configured in the
# main API's own .env (see its INTERNAL_API_SECRET) -- this is a shared
# secret between the two services, never exposed to any frontend.
MAIN_API_INTERNAL_URL="https://api.kwegereza.org"
INTERNAL_API_SECRET="change-this-to-the-exact-same-value-as-the-main-api"

JWT_SECRET="change-this-to-the-exact-same-value-as-the-main-api"

PORT=4001
# The deployed frontend's real origin -- same value you'd set as
# CORS_ORIGIN on the main API.
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="production"

# Optional: only needed if you want the "a class just went live" email
# notification (liveClassEmail) to actually send. Same Gmail App Password
# setup as the main API -- see its own .env.example for the exact steps.
GMAIL_USER="REPLACE_WITH_YOUR_GMAIL_ADDRESS"
GMAIL_APP_PASSWORD="REPLACE_WITH_YOUR_GMAIL_APP_PASSWORD"

# ---- LiveKit (the actual real-time media: audio + screen share) ----
# This service does NOT run LiveKit itself -- LiveKit is its own,
# separately-hosted server (self-hosted on a VPS, or LiveKit Cloud).
# This service only ever talks to it over the network via
# livekit-server-sdk, the same way it talks to the database: as a
# client of another service, never embedding it in-process.
#
# LIVEKIT_URL is the wss:// address the BROWSER connects to directly for
# media (never routed through this backend). LIVEKIT_API_HOST is the
# http(s):// address THIS SERVER uses to call LiveKit's management API
# (create tokens, mute/remove participants, etc.) -- usually the same
# host as LIVEKIT_URL, just a different scheme, so if you leave
# LIVEKIT_API_HOST unset it's derived automatically from LIVEKIT_URL.
LIVEKIT_URL="wss://your-livekit-host.example.com"
LIVEKIT_API_HOST=""
LIVEKIT_API_KEY="REPLACE_WITH_YOUR_LIVEKIT_API_KEY"
LIVEKIT_API_SECRET="REPLACE_WITH_YOUR_LIVEKIT_API_SECRET"
