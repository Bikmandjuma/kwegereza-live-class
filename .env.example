# MUST point at the EXACT SAME database as the main API. This service
# doesn't have its own database -- it shares the main one so LiveClass
# rows, hosts, and attendees all resolve to the same real Users the main
# API knows about.
DATABASE_URL="mysql://user:password@host:3306/kwegereza"

JWT_SECRET="change-this-to-the-exact-same-value-as-the-main-api"

PORT=4001
# The deployed frontend's real origin -- same value you'd set as
# CORS_ORIGIN on the main API.
CORS_ORIGIN=" https://kwegereza.org"
NODE_ENV="production"

# Optional: only needed if you want the "a class just went live" email
# notification (liveClassEmail) to actually send. Same Gmail App Password
# setup as the main API -- see its own .env.example for the exact steps.
GMAIL_USER="REPLACE_WITH_YOUR_GMAIL_ADDRESS"
GMAIL_APP_PASSWORD="REPLACE_WITH_YOUR_GMAIL_APP_PASSWORD"

# Optional: only needed for the browser push ("a class just went live")
# notification. MUST be the exact same keypair as the main API's, since
# push subscriptions were created against those public keys.
VAPID_PUBLIC_KEY="same-value-as-the-main-api"
VAPID_PRIVATE_KEY="same-value-as-the-main-api"
VAPID_SUBJECT="mailto:you@example.com"

# ---- mediasoup (the actual reason this is a separate service) ----
# REQUIRED in production: this VPS's public IP address. Without it,
# mediasoup announces a private/local address to remote peers and only
# same-network participants can connect.
MEDIASOUP_ANNOUNCED_IP="REPLACE_WITH_THIS_VPS_PUBLIC_IP"
MEDIASOUP_LISTEN_IP="0.0.0.0"
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
# Open MEDIASOUP_MIN_PORT-MEDIASOUP_MAX_PORT for BOTH udp and tcp in your
# VPS's firewall/security group, in addition to the usual PORT above.
# MEDIASOUP_NUM_WORKERS=4   # optional; defaults to (CPU cores - 1)
